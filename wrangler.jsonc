{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgeguard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgeguard",
      "database_id": "d11928e7-6cfb-44f9-8819-07a637863664",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SECURITY_EVENTS_QUEUE",
        "queue": "edgeguard-security-events",
      },
    ],
    "consumers": [
      {
        "queue": "edgeguard-security-events",
        "max_batch_size": 10,
      },
    ],
  },
  "ai": {
    "binding": "AI",
  },
}
